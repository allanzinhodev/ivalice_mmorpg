# ============================================================
# ivalice — regras da raiz do monorepo.
# Os .gitignore de client/ e server/ continuam valendo para as
# suas proprias pastas; aqui ficam so as regras transversais.
# ============================================================

# --- ROMs comerciais de Final Fantasy Tactics ---
# Nao versionar: risco de DMCA. O FFTAUtils espera que o usuario
# forneca a ROM (ver tools/FFTAUtils/BIN/rom/PLACE_ROMFILE_ffta.gba_HERE).
# .gba cobre o FFTA; .nds cobre o FFTA2 (Grimoire of the Rift), que e o mesmo
# risco e passava batido -- tools/ffta2.nds ja tinha aparecido como untracked.
tools/rom.gba
*.gba
*.nds

# ObjectBuilder: repositorio proprio (allanzinhodev/backlands-objectbuilder),
# clonado aqui como ferramenta. Tem seu proprio git e seus proprios commits.
tools/ObjectBuilder/

# --- Dependencias compiladas (vcpkg) ---
vcpkg_installed/
.vcpkg_installed/

# --- Arvores de build ---
build/
build-*/
client/vc23/otclient/
# ATENCAO: server/vc18/ NAO e arvore de build -- e o diretorio do projeto MSVC
# do server, com fontes dentro. O server/CMakeLists.txt:337 faz
# `target_sources(tfs PRIVATE ${CMAKE_SOURCE_DIR}/vc18/theforgottenserver.rc)`
# no Windows, entao ignorar a pasta inteira quebra o build em todo clone novo
# ("Cannot find source file"). Ignorar so a saida intermediaria.
server/vc18/*/
x64/
Win32/
[Dd]ebug/
[Rr]elease/

# --- Artefatos de compilacao / link ---
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.a
*.idb
*.tlog
*.suo
*.user

# --- Binarios gerados ---
otclient_gl*.exe
otclient_dx*.exe
theforgottenserver*.exe

# --- Assets pesados ---
# client/android_libs.7z (49 MB) NAO esta listado aqui: client/.gitignore:22 tem
# uma negacao explicita (!android_libs.7z) que vence por ser mais profunda.
# E versionado de proposito pelo upstream.
server/tools/imbuments_scroll.gif

# --- Logs e saidas temporarias ---
server/build-out.txt
*.log
output.log
otclientv8.log

# --- Cache de mapa do servidor ---
server/data/cache/

# --- Configuracao local com credenciais ---
# (server/.gitignore ja cobre config.lua; repetido aqui por seguranca)
server/config.lua
server/config.lua.backup-*
.env
client/build-client.bat
client/build-client-out.txt
